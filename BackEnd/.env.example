# ── Google Gemini (primary LLM engine) ────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model overrides (defaults are set in agents/llm.py)
# GEMINI_PRO_MODEL=gemini-2.5-flash-preview-05-20
# GEMINI_FAST_MODEL=gemini-2.0-flash

# ── AgentRouter (legacy — no longer the primary LLM; keep if you still need it)
# AGENT_ROUTER_API_KEY=
# AGENT_ROUTER_BASE_URL=https://agentrouter.org/v1
# AGENT_ROUTER_FAST_MODEL=claude-haiku-4-5-20251001
# AGENT_ROUTER_PRO_MODEL=claude-opus-4-6

# Tavily Search: https://tavily.com/
TAVILY_API_KEY=

# OpenWeatherMap: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Firebase Admin service account JSON path (relative to backend/, or absolute).
# Example: secrets/tripmiind-firebase-adminsdk.json
FIREBASE_CREDENTIALS_PATH=

# ── RAG / Chroma (optional overrides) ──────────────────────────────────────────
# CHROMA_PERSIST_DIR=data/chroma_db
# CHROMA_COLLECTION=egypt_travel_knowledge
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── HTTP server / CORS ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# `*` for fully open dev; or comma-separated origins, e.g.
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.88:8081
CORS_ORIGINS=*
