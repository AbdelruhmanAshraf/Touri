# ── Google AI Studio API Key for Gemini Multi-Modal Core Engine ──────────────
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDY_API_KEY_HERE

# ── Model selection (Phase 4) ────────────────────────────────────────────────
# Gemma-4 is the default for LangGraph TEXT agents. Multimodal + tool-calling
# paths (audio / image / PDF / function calls) ALWAYS use gemini-2.5-flash
# regardless of the values below — Gemma cannot handle those inputs.
GEMINI_PRO_MODEL=gemma-4-26b-a4b-it
GEMINI_FAST_MODEL=gemma-4-26b-a4b-it

# ── Session JWT (Phase 5 secure cookies) ─────────────────────────────────────
# Replace with a long random string in production.
SESSION_JWT_SECRET=

# ── External services ────────────────────────────────────────────────────────
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# ── HTTP server / CORS ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# SECURITY: Never use * in production. Comma-separated whitelist of origins.
# Example: CORS_ORIGINS=https://touri.app,https://www.touri.app
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Environment (production | development) ───────────────────────────────────
# Controls HTTPS redirect, error detail exposure, HSTS, and CORS strictness.
TOURI_ENV=development

# ── RAG / Chroma (optional overrides) ────────────────────────────────────────
# CHROMA_PERSIST_DIR=data/chroma_db
# CHROMA_COLLECTION=egypt_travel_knowledge
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_BACKEND=auto

# ── Legacy (deprecated after Phase 4 — keep blank) ───────────────────────────
# AGENT_ROUTER_API_KEY=
# AGENT_ROUTER_BASE_URL=https://agentrouter.org/v1
# AGENT_ROUTER_FAST_MODEL=
# AGENT_ROUTER_PRO_MODEL=
